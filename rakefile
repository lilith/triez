require "rbconfig"
require "fileutils"
require 'rake/testtask'
require 'rubocop/rake_task'

include FileUtils

so_file = "ext/triez.#{RbConfig::CONFIG['DLEXT']}"
src_files = Dir.glob('ext/*.{h,c,cc}')
extconf = 'ext/extconf.rb'
vendor_lib = 'ext/build/libtries.a'

# hat-trie sources are now vendored directly in ext/hat-trie/

desc "run tests"
task :default => so_file do
  sh 'ruby', "test/triez_test.rb"
end

desc "build ext"
file so_file => src_files + [extconf, vendor_lib] do
  Dir.chdir 'ext' do
    sh 'ruby', 'extconf.rb'
    sh 'make'
  end
end

file extconf
file vendor_lib

desc "clean ext"
task :clean do
  Dir.chdir 'ext' do
    if File.exist?('Makefile')
      sh 'make', 'clean'
    end
    rm Dir.glob 'build/*.{o,a}'
  end
end


Rake::TestTask.new do |t|
  t.libs << 'test'
  t.test_files = FileList['test/**/*_test.rb']
  t.verbose = true
end

RuboCop::RakeTask.new
